{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:onecell:onecell",
            "tool": "hook_event",
            "timeout": 10,
            "input": {
              "event": "prompt",
              "prompt": "${prompt}",
              "session_id": "${session_id}",
              "client": "claude-code"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:onecell:onecell",
            "tool": "hook_event",
            "timeout": 10,
            "input": {
              "event": "stop",
              "last_message": "${last_assistant_message}",
              "session_id": "${session_id}",
              "client": "claude-code"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:onecell:onecell",
            "tool": "hook_event",
            "timeout": 10,
            "input": {
              "event": "session",
              "source": "${source}",
              "session_id": "${session_id}",
              "client": "claude-code"
            }
          }
        ]
      }
    ]
  }
}